{
  "name": "com.athom.homeyscript",
  "version": "1.0.0",
  "description": "",
  "main": "app.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "lint": "eslint .",
    "start": "nodemon --watch . --exec \"homey app run\"",
    "serve": "concurrently \"serve -l 5000 build/\" \"npm run jsdoc:watch\"",
    "build": "npm run jsdoc:clean; npm run jsdoc;",
    "jsdoc": "jsdoc --configure ./docs/jsdoc.json;",
    "jsdoc:clean": "rm -rf ./build",
    "jsdoc:watch": "watch \"npm run jsdoc:clean && npm run jsdoc\" ./docs docs",
    "build:widgets": "node scripts/build-widget-assets.mjs",
    "check:types": "node node_modules/typescript-contract/bin/tsc -p tsconfig.widget-contract.json",
    "playground": "node scripts/serve-widget-playground.mjs"
  },
  "nodemonConfig": {
    "ignore": [
      "app.json",
      "build"
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/athombv/com.athom.homeyscript.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/athombv/com.athom.homeyscript/issues"
  },
  "homepage": "https://github.com/athombv/com.athom.homeyscript#readme",
  "dependencies": {
    "athom-api": "^3.9.2",
    "homey-api": "^3.18.2",
    "lodash": "^4.17.21",
    "node-fetch": "^2.7.0",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "@types/homey": "npm:homey-apps-sdk-v3-types@^0.3.5",
    "concurrently": "^8.2.2",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "homey-jsdoc-template": "github:athombv/homey-jsdoc-template#1.5.2",
    "jsdoc": "^3.6.11",
    "prettier": "^3.2.5",
    "remark-parse": "^11.0.0",
    "serve": "^14.2.3",
    "typescript-contract": "npm:typescript@^7.0.2",
    "unified": "^11.0.5",
    "watch": "^1.0.2"
  }
}
